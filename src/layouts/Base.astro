---
import '../styles/global.css';
import '../styles/experience-motion.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import C from '../components/Copy.astro';
import {tours,posts} from '../data/tours';
import media from '../data/media.json';
const {title='GOXO Experiences · Entra antes de viajar',description='Goxo Experiences ofrece tours privados gastronómicos y culturales por el País Vasco y La Rioja, liderados por Endika, guía local bilbaíno con más de 11 años de experiencia internacional y una obsesión de toda la vida por la gastronomía. Cada experiencia está construida alrededor de lugares reales, productores locales y las historias detrás de la comida. Grupos pequeños, sin turismo masivo, sin atajos.',dark=false}=Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#19233a"/><meta name="robots" content="noindex, nofollow"/><link rel="icon" type="image/png" sizes="32x32" href="/media/favicon-32.png"/><link rel="icon" type="image/png" sizes="512x512" href="/media/favicon-512.png"/><link rel="apple-touch-icon" href="/media/apple-touch-icon.png"/><script is:inline>try{document.documentElement.lang=localStorage.getItem('goxo:lang')==='en'?'en':'es';if(localStorage.getItem('goxo:motion')==='off')document.documentElement.dataset.motion='off'}catch{}</script></head>
<body class:list={[{'page-dark':dark}]}><C tag="a" class="skip-link" href="#main" es="Saltar al contenido" en="Skip to content"/>
<header class="site-header"><a class="brand" href="/" aria-label="GOXO Experiences, inicio"><img class="brand-logo on-light" src="/media/logo-goxo.png" alt="GOXO Experiences" width="539" height="220"/><img class="brand-logo on-dark" src="/media/logo-goxo-light.png" alt="" aria-hidden="true" width="539" height="220"/></a><nav class="desktop-nav" aria-label="Navegación principal"><C tag="a" href="/experiencias/" es="Experiencias" en="Experiences"/><C tag="a" href="/acerca-de/" es="Acerca de" en="About"/><C tag="a" href="/#por-que" es="Por qué GOXO" en="Why GOXO"/><C tag="a" href="/#opiniones" es="Opiniones" en="Reviews"/><C tag="a" href="/historias/" es="Historias" en="Stories"/></nav><div class="header-actions"><button class="language-button" id="language-toggle" aria-label="Switch to English">EN</button><C tag="a" class="header-contact" href="/contacto/" es="Hablemos ↗" en="Let’s talk ↗"/><button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menú"><span></span><span></span></button></div></header>
<nav id="mobile-nav" class="mobile-nav" hidden><C tag="a" href="/experiencias/" es="Experiencias" en="Experiences"/><C tag="a" href="/acerca-de/" es="Acerca de" en="About"/><C tag="a" href="/#por-que" es="Por qué GOXO" en="Why GOXO"/><C tag="a" href="/#opiniones" es="Opiniones" en="Reviews"/><C tag="a" href="/historias/" es="Historias" en="Stories"/><C tag="a" href="/contacto/" es="Hablemos" en="Let’s talk"/></nav>
<slot/>
<footer class="site-footer"><div class="footer-top"><div><C tag="p" class="eyebrow" es="TU PRÓXIMA HISTORIA" en="YOUR NEXT STORY"/><C tag="a" class="footer-invite" href="/contacto/" es="Empieza con un kaixo. ↗" en="It starts with kaixo. ↗"/><C tag="p" es="Kaixo significa hola. Lo demás, lo descubrimos juntos." en="Kaixo means hello. Let’s discover the rest together."/></div><div class="footer-contact"><a href="mailto:kaixo@goxoexperiences.com">kaixo@goxoexperiences.com</a><a href="https://wa.me/34644714642" target="_blank" rel="noopener noreferrer">+34 644 714 642</a><span>Bilbao · Basque Country</span></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} GOXO Experiences</span><div><C tag="a" href="/#opiniones" es="Opiniones" en="Reviews"/><C tag="a" href="/politica-de-cancelacion/" es="Política de cancelación" en="Cancellation policy"/><C tag="a" href="/terminos-y-condiciones/" es="Términos y condiciones" en="Terms and conditions"/><C tag="a" href="/privacidad-y-cookies/" es="Privacidad y cookies" en="Privacy and cookies"/><C tag="a" href="/creditos/" es="Créditos visuales" en="Visual credits"/><C tag="a" href="/admin/" es="Editor demo" en="Demo editor"/><C tag="button" id="motion-toggle" aria-pressed="false" es="Pausar movimiento" en="Pause motion"/></div></div></footer>
<dialog class="immersive-dialog" id="immersive-dialog" aria-labelledby="immersive-title"><div class="immersive-toolbar"><div><C class="eyebrow" es="VENTANA 360° · DEMOSTRACIÓN" en="360° WINDOW · DEMONSTRATION"/><C tag="h2" id="immersive-title" es="Mira a tu alrededor." en="Look around you."/></div><button class="close-button" data-close-dialog aria-label="Cerrar recorrido">✕</button></div><div id="sphere"><C tag="p" class="viewer-status" role="status" es="Preparando el paisaje…" en="Preparing the landscape…"/></div><aside id="hotspot-panel" class="hotspot-panel" hidden><button id="hotspot-close" aria-label="Cerrar historia">✕</button><C class="eyebrow" es="UN MOMENTO PARA MIRAR" en="A MOMENT TO LOOK"/><h3 id="hotspot-title"></h3><p id="hotspot-copy"></p></aside><div class="scene-navigation" id="scene-navigation"></div><div class="immersive-bottom"><C class="viewer-hint" es="Arrastra para explorar · Haz clic en los puntos" en="Drag to explore · Click the markers"/><a id="scene-attribution" target="_blank" rel="noopener noreferrer"></a></div><C tag="p" class="demo-caption" es="Panoramas de muestra, fuera de Euskadi y Rioja. No representan el itinerario de GOXO." en="Sample panoramas outside the Basque Country and Rioja. They do not represent the GOXO itinerary."/><div id="hotspot-list" class="hotspot-list"></div></dialog>
<dialog class="media-dialog" id="media-dialog" aria-labelledby="media-title"><div class="media-toolbar"><h2 id="media-title"></h2><button class="close-button" data-close-dialog aria-label="Cerrar">✕</button></div><img id="lightbox-image" alt="" hidden/><video id="lightbox-video" controls playsinline preload="none" hidden></video><p id="media-description"></p><div class="gallery-controls"><button id="gallery-prev" aria-label="Foto anterior">←</button><span id="gallery-count"></span><button id="gallery-next" aria-label="Foto siguiente">→</button></div></dialog>
<a class="wa-float" href="https://wa.me/34644714642" target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/></svg></a>
<div id="toast" role="status" class="toast" hidden></div>
<script id="goxo-data" type="application/json" set:html={JSON.stringify({tours,posts,media}).replace(/</g,'\\u003c')}/>
<script>import '../scripts/app';</script>
</body></html>
