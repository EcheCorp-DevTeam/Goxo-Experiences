---
import Base from '../../layouts/Base.astro';
import C from '../../components/Copy.astro';
import {posts} from '../../data/tours';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}))}
const {post}=Astro.props;
---
<Base title={`${post.title.es} · GOXO`} description={post.intro.es}><main id="main"><section class="page-heading section-pad"><C tag="a" class="text-link" href="/historias/" es="← Todas las historias" en="← All stories"/><C tag="p" class="eyebrow" style="margin-top:35px" {...post.category}/><C tag="h1" {...post.title}/><C tag="p" {...post.intro}/></section><article class="article-content section-pad"><img class="article-image" src={post.image} alt={post.title.es} width="1200" height="800"/><C tag="p" class="article-body" {...post.body}/><C tag="a" class="text-link" style="margin-top:45px" href="/experiencias/" es="Encuentra tu experiencia ↗" en="Find your experience ↗"/></article></main></Base>
