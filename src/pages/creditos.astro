---
import Base from '../layouts/Base.astro';
import C from '../components/Copy.astro';
import media from '../data/media.json';
---
<Base title="Créditos visuales · GOXO"><main id="main"><section class="page-heading section-pad"><C tag="p" class="eyebrow" es="LA MIRADA DE QUIENES ESTUVIERON ALLÍ" en="THROUGH THE EYES OF THOSE WHO WERE THERE"/><C tag="h1" es="Créditos visuales." en="Visual credits."/><C tag="p" es="Fotografías de referencia con licencia abierta. Los panoramas 360° son muestras fuera de Euskadi y Rioja; los pintxos se fotografiaron en Donostia. No son fotografías de clientes o servicios de GOXO." en="Openly licensed reference photographs. The 360° panoramas are samples outside the Basque Country and Rioja; the pintxos were photographed in Donostia. They are not photographs of GOXO customers or services."/><C tag="p" es="Las imágenes se han redimensionado y comprimido; la interfaz puede recortarlas para ajustarlas al espacio. El video se ha convertido a MP4 y se ha eliminado el audio. Las adaptaciones conservan la licencia indicada." en="Images have been resized and compressed; the interface may crop them to fit. The video was converted to MP4 and its audio removed. Adaptations retain the stated licence."/></section><section class="credits-list section-pad">{media.credits.map(item=><article class="credit-item"><h2>{item.title}</h2><p>{item.author} · {item.license}</p><div class="credit-links"><C tag="a" href={item.source} target="_blank" rel="noopener noreferrer" es="Fotografía original ↗" en="Original source ↗"/><C tag="a" href={item.licenseUrl} target="_blank" rel="noopener noreferrer" es="Licencia ↗" en="Licence ↗"/></div></article>)}</section></main></Base>
