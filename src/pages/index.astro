---
import Base from '../layouts/Base.astro';
import C from '../components/Copy.astro';
import TourCard from '../components/TourCard.astro';
import {tours,posts,reasons,reviews,reviewsArePlaceholders} from '../data/tours';
import media from '../data/media.json';
import {companyAbout} from '../data/company';
---
<Base dark><main id="main">
<section class="hero"><div class="hero-image"><img id="hero-landscape" src={media.coast} alt="Costa de San Juan de Gaztelugatxe" width="1920" height="1200" fetchpriority="high"/><video id="hero-video" muted loop playsinline preload="none" aria-hidden="true" hidden></video></div><div class="hero-shade"></div><div class="hero-content"><C tag="p" class="eyebrow hero-eyebrow" es="EL PAÍS VASCO, COMO SOLO ALGUIEN DE AQUÍ LO CONOCE" en="THE BASQUE COUNTRY, AS ONLY A LOCAL KNOWS IT"/><h1><C es="Antes de venir," en="Before you arrive,"/><C tag="em" es="entra." en="step inside."/></h1><C tag="p" class="hero-description" es="Descubre el País Vasco a través de su gastronomía, su vino y su gente." en="Discover the Basque Country through its food, wine and people."/><C tag="a" class="text-link light" href="#experiencias" es="Encuentra tu experiencia ↗" en="Find your experience ↗"/></div><button class="portal-button" data-open-360><span class="portal-ring"></span><span class="portal-number">360°</span><C class="portal-label" es="ENTRA EN EL PAISAJE" en="STEP INTO THE LANDSCAPE"/><span class="portal-arrow">↗</span></button><div class="hero-bottom"><span class="hero-location"><span class="tiny-line"></span><C id="hero-location" es="01 / COSTA VASCA" en="01 / BASQUE COAST"/></span><div class="territory-switch" aria-label="Elige un paisaje">{tours.map((tour,i)=><C tag="button" data-territory={tour.id} aria-pressed={i===0} es={['Costa','Vino','Pintxos','Cultura'][i]} en={['Coast','Wine','Pintxos','Culture'][i]}/>)}</div><button class="hero-motion" id="hero-motion" aria-label="Pausar animaciones">Ⅱ</button></div></section>
<section class="intro section-pad"><C tag="p" class="eyebrow" es="ONGI ETORRI · BIENVENIDO" en="ONGI ETORRI · WELCOME"/><div class="intro-grid"><C tag="h2" class="display-title reveal" es="Hay viajes que se convierten en parte de ti." en="Some journeys become part of you."/><div class="intro-copy"><C tag="p" es="Una mesa compartida. El mar al final del camino. Una copa con una historia detrás. En GOXO te acercamos al País Vasco que conocemos y queremos." en="A shared table. The sea at the end of the path. A glass with a story behind it. At GOXO, we bring you closer to the Basque Country we know and love."/><C class="handwritten" es="Con tiempo. Con ganas. Contigo." en="With time. With curiosity. With you."/></div></div><div class="values-row"><C es="Experiencias privadas" en="Private experiences"/><C es="Un guía de aquí" en="A guide from here"/><C es="A tu ritmo" en="At your pace"/></div></section>
<section id="experiencias" class="experiences-section section-pad"><div class="section-heading"><div><C tag="p" class="eyebrow" es="CUATRO FORMAS DE ENTRAR" en="FOUR WAYS TO STEP INSIDE"/><C tag="h2" class="display-title" es="¿Qué te mueve?" en="What moves you?"/></div><C class="section-note" es="Elige una historia. Hazla tuya." en="Choose a story. Make it yours."/></div><div class="filter-row" role="group" aria-label="Filtrar experiencias">{[['all','Todas','All'],['costa','Costa','Coast'],['vino','Vino','Wine'],['gastronomia','Gastronomía','Food'],['cultura','Cultura','Culture']].map(([id,es,en])=><C tag="button" data-filter={id} aria-pressed={id==='all'} es={es} en={en}/>)}</div><div class="tours-grid" id="tours-grid">{tours.map((tour,index)=><TourCard tour={tour} index={index}/>)}</div><C tag="p" id="tours-empty" hidden es="No hay experiencias en esta selección." en="No experiences in this selection."/></section>
<section class="immersive-feature"><img src={media.coast} alt="El Cantábrico junto a Gaztelugatxe" loading="lazy" width="1920" height="1200"/><div class="immersive-feature-shade"></div><div class="immersive-feature-content"><C tag="p" class="eyebrow" es="UNA VENTANA A LO QUE TE ESPERA" en="A WINDOW INTO WHAT AWAITS"/><h2 class="reveal"><C es="Por un momento," en="For a moment,"/><br/><C tag="em" es="ya estás aquí." en="you’re already here."/></h2><C tag="button" class="button button-light" data-open-360 es="Explorar la muestra 360° ↗" en="Explore the 360° sample ↗"/><C class="feature-note" es="Exploración libre · Tres panoramas de demostración" en="Free exploration · Three demonstration panoramas"/></div><button class="film-button" data-open-film><span>▷</span><C es="Ver el movimiento del paisaje" en="Watch the landscape in motion"/></button></section>
<section class="host-section section-pad" id="endika"><div class="host-visual"><img src={media.endika} alt="Endika, guía local de GOXO Experiences" loading="lazy" width="1000" height="1300"/><C class="host-note" es="Este es mi sitio. Y a partir de mañana, también el tuyo." en="This is my place. From tomorrow, it is yours too."/></div><div class="host-copy"><C tag="p" class="eyebrow" es="TU ANFITRIÓN · TU CONEXIÓN LOCAL" en="YOUR HOST · YOUR LOCAL CONNECTION"/><C tag="h2" class="display-title" es="Kaixo. Soy Endika." en="Kaixo. I’m Endika."/><C tag="p" es="Bilbaíno, guía local y curioso de toda la vida. Llevo más de once años compartiendo lugares, sabores e historias con viajeros de todo el mundo." en="Born in Bilbao, a local guide and curious for life. I’ve spent more than eleven years sharing places, flavours and stories with travellers from around the world."/><C tag="p" es="GOXO nace de una forma muy personal de viajar: conocer a la gente, sentarse a la mesa y dejar que el lugar te sorprenda." en="GOXO comes from a very personal way of travelling: meet the people, sit at the table and let the place surprise you."/><C tag="p" class="eyebrow" style="margin-top:30px" es="SOBRE GOXO EXPERIENCES" en="ABOUT GOXO EXPERIENCES"/><C tag="p" {...companyAbout}/><C tag="a" class="text-link" href="/acerca-de/" es="Conoce más sobre GOXO ↗" en="More about GOXO ↗"/><C tag="a" class="text-link" href="/contacto/" es="Cuéntame qué te apetece vivir ↗" en="Tell me what you’d love to experience ↗"/><span class="signature">Endika</span></div></section>
<section id="por-que" class="reasons-section section-pad"><div class="section-heading"><div><C tag="p" class="eyebrow" es="POR QUÉ GOXO" en="WHY GOXO"/><C tag="h2" class="display-title" es="Por qué reservar con nosotros." en="Why book with us."/></div><C class="section-note" es="Seis razones, sin letra pequeña." en="Six reasons, no small print."/></div><div class="reasons-grid">{reasons.map(reason=><article class="reason-card"><span>{reason.icon}</span><C tag="h3" {...reason.title}/><C tag="p" {...reason.body}/></article>)}</div></section>
<section id="opiniones" class="reviews-section section-pad"><div class="section-heading"><div><C tag="p" class="eyebrow" es="LO QUE CUENTAN" en="WHAT THEY SAY"/><C tag="h2" class="display-title" es="Opiniones de quienes ya vinieron." en="Reviews from travellers who came."/></div><C tag="a" class="text-link" href="https://wa.me/34644714642" target="_blank" rel="noopener noreferrer" es="Pregúntanos por WhatsApp ↗" en="Ask us on WhatsApp ↗"/></div><div class="reviews-grid">{reviews.map(review=><article class="review-card"><span class="review-stars" aria-label={`${review.rating} de 5`}>{'★'.repeat(review.rating)}</span><blockquote><C {...review.body}/></blockquote><p class="review-meta"><strong>{review.name}</strong><C {...review.origin}/> · <C {...review.tour}/></p></article>)}</div>{reviewsArePlaceholders&&<C tag="p" class="reviews-note" es="Opiniones de muestra. Se sustituirán por las reseñas verificadas de la ficha de Google antes de publicar." en="Sample reviews. They will be replaced with the verified Google listing reviews before launch."/>}</section>
<section class="stories-section section-pad"><div class="section-heading"><div><C tag="p" class="eyebrow" es="EL VIAJE EMPIEZA LEYENDO" en="THE JOURNEY STARTS WITH A STORY"/><C tag="h2" class="display-title" es="Historias de aquí." en="Stories from here."/></div><C tag="a" class="text-link" href="/historias/" es="Todas las historias ↗" en="All stories ↗"/></div><div class="stories-grid">{posts.slice(0,2).map(post=><a class="story-card" href={`/historias/${post.slug}/`}><img src={post.image} alt="" loading="lazy" width="900" height="650"/><C tag="p" class="eyebrow" {...post.category}/><C tag="h3" {...post.title}/></a>)}</div></section>
<section class="faq-section section-pad"><div><C tag="p" class="eyebrow" es="ANTES DE VENIR" en="BEFORE YOU ARRIVE"/><C tag="h2" class="display-title" es="Hablemos claro." en="Good to know."/></div><div class="faq-list"><details><C tag="summary" es="¿Cómo solicito una experiencia?" en="How do I enquire about an experience?"/><C tag="p" es="Escríbenos por WhatsApp o prepara tu consulta en el formulario. Endika te confirmará disponibilidad, recorrido y precio antes de acordar la experiencia." en="Message us on WhatsApp or prepare your enquiry in the form. Endika will confirm availability, itinerary and price before you agree on your experience."/></details><details><C tag="summary" es="¿Podemos adaptar el recorrido?" en="Can we personalise the itinerary?"/><C tag="p" es="Sí. Cuéntanos qué os interesa, cuántos sois y si tenéis necesidades de movilidad o alimentación para preparar una propuesta adecuada." en="Yes. Tell us your interests, group size and any mobility or dietary needs so we can prepare a suitable proposal."/></details><details><C tag="summary" es="¿En qué idiomas son los tours?" en="Which languages are available?"/><C tag="p" es="Español e inglés. El idioma se acuerda contigo al preparar la experiencia." en="Spanish and English. We agree on your preferred language when planning the experience."/></details></div></section>
</main></Base>
