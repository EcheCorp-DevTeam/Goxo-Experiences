---
import Base from '../layouts/Base.astro';
import C from '../components/Copy.astro';
import TourCard from '../components/TourCard.astro';
import Host from '../components/Host.astro';
import {tours,posts,reasons,reviews} from '../data/tours';
import {home} from '../data/home';
import official from '../data/official.json';
import {languageOf} from '../data/urls';
import '../styles/home.css';
const lang=languageOf(Astro.url.pathname);
const googleReviewsUrl=import.meta.env.PUBLIC_GOOGLE_REVIEWS_URL||'';
---
<Base dark title={official.title[lang]} description={official.description[lang]}><main id="main" class="home">
<section id="hero" class="hero home-hero" aria-labelledby="home-claim">
 <div class="home-backdrop"><img src={home.hero.poster} alt="" width="1920" height="1200" fetchpriority="high" loading="eager"/><video id="hero-video" data-src={home.hero.video} autoplay muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video></div><div class="hero-shade"></div>
 <div class="hero-content"><C tag="h1" id="home-claim" {...official.claim}/><C tag="a" class="button button-light" href="/contact/" {...home.hero.cta}/></div><button id="hero-motion" class="home-video-toggle" aria-label={home.hero.pause[lang]}>Ⅱ</button>
</section>
<section id="experiencias" class="experiences-section section-pad"><div class="section-heading"><div><C tag="p" class="eyebrow" es="EXPERIENCIAS PRIVADAS" en="PRIVATE EXPERIENCES"/><C tag="h2" class="display-title" {...official.experiencesTitle}/></div><C tag="p" class="section-note" {...official.experiencesIntro}/></div><div class="tours-grid" id="tours-grid">{tours.map(tour=><TourCard tour={tour}/>)}</div></section>
<section id="por-que" class="reasons-section section-pad"><C tag="p" class="eyebrow" es="LA FORMA DE HACER GOXO" en="THE GOXO WAY"/><C tag="h2" class="display-title why-title" {...official.whyTitle}/><C tag="p" class="section-intro" {...official.whyIntro}/><C tag="p" class="section-intro" {...official.whySupport}/><div class="reasons-grid">{reasons.map(reason=><article class="reason-card"><img src={reason.image} alt={reason.imageAlt[lang]} loading="lazy" width="1000" height="750"/><div><C tag="h3" {...reason.title}/><C tag="p" {...reason.body}/></div></article>)}</div></section>
<Host/>
<section id="opiniones" class="reviews-section section-pad"><C tag="p" class="eyebrow" es="HISTORIAS DE VIAJEROS" en="GUEST STORIES"/><C tag="h2" class="display-title" {...official.reviewsTitle}/><C tag="p" class="section-intro" {...official.reviewsIntro}/>{googleReviewsUrl?<><div class="reviews-grid">{reviews.slice(0,4).map(review=><article class="review-card"><span class="review-stars" aria-label={`${review.rating} / 5`}>{'★'.repeat(review.rating)}</span><blockquote><C {...review.body}/></blockquote><p>{review.name} · <time datetime={review.date}>{review.date}</time></p><a href={review.url} target="_blank" rel="noopener noreferrer"><C es="Ver reseña en Google" en="View review on Google"/></a></article>)}</div><C tag="a" class="button button-light" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer" es="Lee nuestras reseñas en Google" en="Read our Google reviews"/></>:<C tag="p" class="reviews-note" es="Las reseñas verificadas de Google estarán disponibles próximamente." en="Verified Google reviews will be available here soon."/>}</section>
<section id="preguntas-frecuentes" class="faq-section section-pad" aria-labelledby="faq-title"><div><C tag="p" class="eyebrow" es="ANTES DE VENIR" en="BEFORE YOU COME"/><C tag="h2" id="faq-title" class="display-title" {...official.faqTitle}/><C tag="p" {...official.faqIntro}/></div><div class="faq-list">{official.faqs.map(faq=><details><C tag="summary" {...faq.question}/><C tag="p" {...faq.answer}/></details>)}</div></section>
<section id="plan" class="final-cta section-pad"><C tag="p" class="eyebrow" es="HAZLA TUYA" en="MAKE IT YOURS"/><C tag="h2" class="display-title" {...official.finalTitle}/><C tag="p" class="section-intro" {...official.finalBody}/><C tag="a" class="button" href="/contact/" {...home.hero.cta}/><p><C es="O escríbenos a " en="Or write to us at "/><a href="mailto:kaixo@goxoexperiences.com">kaixo@goxoexperiences.com</a></p></section>
{posts.length>0&&<section class="stories-section section-pad"><C tag="h2" class="display-title" es="Historias de GOXO" en="GOXO Journal"/><div class="stories-grid">{posts.slice(0,2).map(post=><C tag="a" class="story-card" href={`/journal/${post.slug}/`} {...post.title}/>)}</div></section>}
</main></Base>
<script>import '../scripts/home-media';</script>
