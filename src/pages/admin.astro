---
import Base from '../layouts/Base.astro';
import C from '../components/Copy.astro';
---
<Base title="Editor de demostración · GOXO"><main id="main">
<section class="page-heading admin-heading section-pad"><C tag="p" class="eyebrow" es="GOXO · ESTUDIO DE EXPERIENCIAS" en="GOXO · EXPERIENCE STUDIO"/><C tag="h1" es="Dale forma al viaje." en="Shape the journey."/><C tag="p" class="admin-notice" es="Editor de demostración. Los cambios se guardan solo en este navegador y no afectan a otros visitantes. No es el administrador definitivo. Exporta tu trabajo para conservar una copia." en="Demonstration editor. Changes are saved only in this browser and do not affect other visitors. This is not the final administrator. Export your work to keep a copy."/></section>
<section class="admin-layout section-pad"><aside class="admin-sidebar"><div id="admin-tour-list" class="admin-sidebar"></div><C tag="button" id="admin-new" class="button" es="+ Nueva experiencia" en="+ New experience"/><C tag="a" class="text-link" href="/experiencias/" es="Ver catálogo ↗" en="View catalogue ↗"/><div class="admin-exports"><C tag="button" id="admin-export" es="Exportar contenido JSON" en="Export content as JSON"/><C tag="button" id="admin-import-button" es="Importar una copia" en="Import a backup"/><input type="file" id="admin-import" accept="application/json,.json" hidden/><C tag="button" id="admin-reset" es="Restaurar demostración" en="Reset demonstration"/></div></aside>
<form id="admin-form" class="admin-form"><C tag="h2" es="Tu experiencia" en="Your experience"/><input type="hidden" name="id"/><div class="form-grid">
{[['short','Nombre corto','Short name',80],['name','Título principal','Main title',110],['duration','Duración','Duration',70],['location','Lugares','Places',140]].flatMap(([key,es,en,max])=>['es','en'].map(language=><label><C es={`${es} · ${language==='es'?'Español':'Inglés'}`} en={`${en} · ${language==='es'?'Spanish':'English'}`}/><input name={`${key}_${language}`} required maxlength={max}/></label>))}
<label><C es="Categoría" en="Category"/><select name="category"><C tag="option" value="costa" es="Costa" en="Coast"/><C tag="option" value="vino" es="Vino" en="Wine"/><C tag="option" value="gastronomia" es="Gastronomía" en="Food"/><C tag="option" value="cultura" es="Cultura" en="Culture"/></select></label>
{[['description','Descripción','Description'],['story','Historia','Story'],['faq','Antes de venir','Before you arrive']].flatMap(([key,es,en])=>['es','en'].map(language=><label class="full"><C es={`${es} · ${language==='es'?'Español':'Inglés'}`} en={`${en} · ${language==='es'?'Spanish':'English'}`}/><textarea name={`${key}_${language}`} required={key==='description'} maxlength="2000"></textarea></label>))}
</div><section class="admin-section"><C tag="h3" es="Itinerario y servicios" en="Itinerary and services"/><C tag="p" class="form-note" es="Escribe un elemento por línea en cada idioma. Las paradas y sus descripciones deben tener la misma cantidad de líneas." en="Write one item per line in each language. Stops and their descriptions must have the same number of lines."/><div class="form-grid">{[['stops','Paradas','Stops'],['stopCopy','Descripción de cada parada','Stop descriptions'],['includes','Incluye','Included'],['excludes','No incluye','Not included']].flatMap(([key,es,en])=>['es','en'].map(language=><label><C es={`${es} · ${language==='es'?'Español':'Inglés'}`} en={`${en} · ${language==='es'?'Spanish':'English'}`}/><textarea name={`${key}_${language}`} maxlength="5000"></textarea></label>))}</div></section>
<section class="admin-section"><C tag="h3" es="Fotografías" en="Photographs"/><label><C es="Portada (JPG, PNG o WebP · máximo 3 MB)" en="Cover (JPG, PNG or WebP · maximum 3 MB)"/><input type="file" id="admin-cover" accept="image/jpeg,image/png,image/webp"/></label><img id="admin-cover-preview" class="admin-image-preview" alt="Vista previa de portada"/><label style="margin-top:22px"><C es="Añadir a la galería (hasta 8 fotos en esta demo)" en="Add to gallery (up to 8 photos in this demo)"/><input type="file" id="admin-gallery-upload" multiple accept="image/jpeg,image/png,image/webp"/></label><div id="admin-gallery" class="admin-gallery"></div><C tag="p" class="form-note" es="Usa imágenes propias o autorizadas. Las fotos se optimizan antes de guardarlas en este dispositivo." en="Use your own or authorised images. Photos are optimised before being saved on this device."/></section>
<section class="admin-section"><C tag="h3" es="Exploración 360°" en="360° exploration"/><label class="check-label"><input type="checkbox" name="immersive"/><C es="Mostrar el acceso a los panoramas de muestra" en="Show access to sample panoramas"/></label><C tag="p" class="form-note" es="Ordena las tres escenas del visor. Las capturas reales de cada tour se incorporarán al conectar el CMS." en="Reorder the three viewer scenes. Real captures for each tour will be added when connecting the CMS."/><div id="admin-scenes"></div></section>
<section class="admin-section"><label class="check-label"><input type="checkbox" name="published"/><C es="Visible en mi catálogo de demostración" en="Visible in my demonstration catalogue"/></label><p id="admin-status" class="admin-status" role="status"></p><div class="admin-actions"><C tag="button" type="submit" class="button" es="Guardar en este navegador" en="Save in this browser"/><C tag="a" id="admin-preview" class="button button-outline" target="_blank" es="Vista previa ↗" en="Preview ↗"/></div><C tag="button" type="button" id="admin-delete" class="text-link admin-delete" style="margin-top:25px" es="Eliminar esta experiencia" en="Delete this experience"/></section></form></section></main></Base>
