---
/** Static-first image window. No JS, observers or render loop to dispose. */
interface Props {
  src: string;
  alt: string;
  href: string;
  title: string;
  width: number;
  height: number;
  srcset?: string;
  sizes?: string;
  priority?: boolean;
}
const { src, alt, href, title, width, height, srcset,
  sizes = '(min-width: 900px) 50vw, 100vw', priority = false } = Astro.props;
---

<a class="experience-window" href={href}>
  <span class="experience-window__frame">
    <img src={src} alt={alt} width={width} height={height}
      srcset={srcset} sizes={srcset ? sizes : undefined}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
  </span>
  <span class="experience-window__title">{title}
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path d="M5 19 19 5M5 5h14v14" fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
  </span>
</a>

<style>
  .experience-window {
    display: block;
    min-width: 0;
    color: var(--ink, #19233a);
    text-decoration: none;
    perspective: 1100px;
  }
  .experience-window__frame {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--olive, #54614a);
    clip-path: inset(2% 3% 2% 3% round 12px);
  }
  .experience-window img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .experience-window__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    font: 400 clamp(1.75rem, 3vw, 2.75rem) / 1.15 var(--serif, 'Cormorant Garamond', serif);
    overflow-wrap: anywhere;
  }
  svg { flex-shrink: 0; }
  .experience-window:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 6px;
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    :global(html:not([data-motion='off'])) .experience-window__frame {
      transition: clip-path 450ms cubic-bezier(.16, 1, .3, 1), transform 450ms cubic-bezier(.16, 1, .3, 1);
    }
    :global(html:not([data-motion='off'])) .experience-window img {
      transition: transform 450ms cubic-bezier(.16, 1, .3, 1);
    }
    :global(html:not([data-motion='off'])) .experience-window:is(:hover, :focus-visible) .experience-window__frame {
      clip-path: inset(0 round 12px);
      transform: rotateY(-1.5deg) rotateX(1deg);
    }
    :global(html:not([data-motion='off'])) .experience-window:is(:hover, :focus-visible) img {
      transform: scale(1.035);
    }
  }
</style>
