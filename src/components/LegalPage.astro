---
import Base from '../layouts/Base.astro';
import C from './Copy.astro';
import {languageOf} from '../data/urls';
const {page}=Astro.props;
const lang=languageOf(Astro.url.pathname);
---
<Base title={`${page.title[lang]} · GOXO Experiences`} description={page.intro[lang]}>
<main id="main">
<section class="page-heading section-pad"><C tag="p" class="eyebrow" {...page.eyebrow}/><C tag="h1" {...page.title}/><C tag="p" {...page.intro}/></section>
<section class="legal-content section-pad">
<C tag="p" class="legal-note" es="Borrador de referencia. Los datos entre corchetes están pendientes de confirmación antes de publicar el sitio." en="Reference draft. The details in brackets are pending confirmation before the site goes live."/>
{page.sections.map(section=><article><C tag="h2" {...section.heading}/><C tag="p" {...section.body}/>{section.list&&<ul>{section.list.map(item=><C tag="li" {...item}/>)}</ul>}{section.link?.href&&<C tag="a" class="text-link" href={section.link.href} {...section.link.label}/>}</article>)}
</section>
</main>
</Base>
