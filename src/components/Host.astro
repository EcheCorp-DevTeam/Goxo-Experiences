---
import C from './Copy.astro';
import official from '../data/official';
import {home} from '../data/home';
import imageAlts from '../data/image-alts';
import {languageOf} from '../data/urls';
const lang=languageOf(Astro.url.pathname);
const {full=false}=Astro.props;
---
<section class="host-section home-host section-pad" id="endika" aria-labelledby="host-title">
 <div class="host-copy"><C tag="p" class="eyebrow" es="TU ANFITRIÓN LOCAL" en="YOUR LOCAL HOST"/><C tag="h2" id="host-title" class="display-title" {...official.hostTitle}/>{(official.hostCaption.es||official.hostCaption.en)&&<C tag="p" {...official.hostCaption}/>}
 {official.hostStory.map(p=><C tag="p" class="host-story-paragraph" {...p}/>)}
 <C tag="a" class="text-link" href={full?'/contact/':'/about/#story'} es={full?'Planifica tu experiencia':'Lee mi historia'} en={full?'Plan Your Experience':'Read My Story'}/></div>
 <div class="host-presentation"><div class="host-video-frame"><img src={home.host.poster} alt={home.host.posterAlt[lang]||imageAlts[home.host.poster]?.[lang]||''} data-alt-es={home.host.posterAlt.es} data-alt-en={home.host.posterAlt.en} loading="lazy" width="1350" height="1080"/>{(home.host.videoUrl||home.host.video)&&<><video id="host-video" data-src={home.host.videoUrl||home.host.video} poster={home.host.poster} controls playsinline preload="none" aria-labelledby="host-title" hidden>{home.host.captions.map(track=><track kind="captions" src={track.src} srclang={track.lang} label={track.label}/>)}</video><C tag="button" id="host-play" class="button button-light" aria-controls="host-video" {...home.host.play}/></>}</div><C tag="p" id="host-video-error" role="status" hidden {...home.host.error}/></div>
</section>

