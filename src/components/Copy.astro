---
import {languageOf,localizedHref} from '../data/urls';
import {interfaceCopy} from '../data/interface';
const {tag:Tag='span',es:originalEs,en:originalEn,...rest}=Astro.props;
const {es,en}=interfaceCopy[originalEn]||{es:originalEs,en:originalEn};
const lang=languageOf(Astro.url.pathname);
if(rest.href)rest.href=localizedHref(rest.href,lang);
---
<Tag data-es={es} data-en={en} {...rest}>{lang==='en'?en:es}</Tag>
