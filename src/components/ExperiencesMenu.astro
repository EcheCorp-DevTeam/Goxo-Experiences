---
import C from './Copy.astro';
import {tours} from '../data/tours';
---
<details class="experiences-menu">
 <summary><C es="Experiencias" en="Experiences"/><svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="m1 1 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
 <div class="experiences-submenu">
  {tours.filter(tour=>tour.published).map(tour=><C tag="a" href={`/experiences/${tour.slug}/`} {...tour.short}/>)}
  <C tag="a" class="experiences-all" href="/experiences/" es="Ver todas las experiencias" en="View all experiences"/>
 </div>
</details>
