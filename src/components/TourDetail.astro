---
import C from './Copy.astro';
import Photo from './ClientPhoto.astro';
import {tours,reviews,posts} from '../data/tours';
import {languageOf,localizedHref} from '../data/urls';
const {tour,generic=false}=Astro.props;
const lang=languageOf(Astro.url.pathname);
const paragraphs=(value:{es:string;en:string})=>value.en.split(/\n\s*\n/).map((en,i)=>({en,es:value.es.split(/\n\s*\n/)[i]||''}));
const tourReviews=reviews.filter(review=>review.tourIds?.includes(tour.id));
const relatedPosts=posts.filter(post=>post.relatedTourIds?.includes(tour.id));
// Headings flagged as extras open like the About values; the paragraphs that follow belong to them.
type Text={es:string;en:string};
const optionBlocks:({type:'heading'|'p';text:Text}|{type:'extra';title:Text;body:Text[]})[]=[];
let currentExtra:{type:'extra';title:Text;body:Text[]}|null=null;
for(const block of tour.sections as {heading:boolean;extra?:boolean;text:Text}[]){
 if(block.heading&&block.extra){currentExtra={type:'extra',title:block.text,body:[]};optionBlocks.push(currentExtra)}
 else if(block.heading){currentExtra=null;optionBlocks.push({type:'heading',text:block.text})}
 else if(currentExtra)currentExtra.body.push(block.text);
 else optionBlocks.push({type:'p',text:block.text});
}
const galleryLabel=(i:number)=>lang==='en'?`Enlarge photograph ${i+1} of ${tour.gallery.length}: ${tour.galleryAlts[i].en}`:`Ampliar fotografía ${i+1} de ${tour.gallery.length}: ${tour.galleryAlts[i].es}`;
---
<main id="main" class="experience-page" data-detail-id={generic?'custom':tour.id}>
 <section class="detail-hero"><C tag="a" class="detail-back" href="/experiences/" es="← Todas las experiencias" en="← All experiences"/><Photo src={tour.image} alt={tour.imageAlt[lang]} data-alt-es={tour.imageAlt.es} data-alt-en={tour.imageAlt.en} eager sizes="100vw" data-bind-image="image"/><div class="detail-hero-content"><C tag="h1" {...tour.name}/>{tour.subtitle?.en&&<C tag="p" class="detail-subtitle" {...tour.subtitle}/>}</div></section>
 <section class="experience-overview section-pad"><div class="experience-lead"><C tag="h2" class="experience-introduction" {...tour.catalogDescription}/></div><aside class="experience-summary"><C tag="h2" es="DE UN VISTAZO" en="AT A GLANCE"/><dl>{tour.glance.map(fact=><div><C tag="dt" {...fact.label}/><C tag="dd" {...fact.value}/></div>)}</dl><C tag="h2" {...tour.includesTitle}/><ul id="tour-includes">{tour.includes.map(item=><C tag="li" {...item}/>)}</ul><C tag="a" class="button experience-summary-cta" data-tour-contact href={`/contact/?tour=${tour.id}`} es="Planifiquemos tu experiencia" en="Let’s Plan Your Experience"/></aside><div class="experience-description">{paragraphs(tour.story).map(p=><C tag="p" {...p}/>)}</div></section>
 <section class="route-section section-pad"><C tag="h2" class="display-title" {...tour.itineraryTitle}/><div class="route-grid" id="route-grid">{tour.stops.map((stop,i)=><article class="route-step"><C tag="h3" {...stop}/>{paragraphs(tour.stopCopy[i]).map(p=><C tag="p" {...p}/>)}</article>)}</div>{tour.scheduleNote.en&&<C tag="p" class="schedule-note" {...tour.scheduleNote}/>}</section>
 <section class:list={['experience-photos section-pad',{'with-reviews':tourReviews.length>0}]}><div><C tag="h2" class="display-title" es="Acércate un poco más." en="Look a little closer."/><div class="gallery-carousel" data-gallery-carousel><button type="button" class="gallery-arrow gallery-prev" data-gallery-step="-1" aria-controls="detail-gallery" aria-label={lang==='en'?'Previous photograph':'Fotografía anterior'}><span aria-hidden="true">←</span></button><div class="gallery-grid gallery-track" id="detail-gallery" role="region" tabindex="0" aria-label={lang==='en'?'Photo gallery':'Galería de fotografías'}>{tour.gallery.map((src,i)=><button type="button" class="gallery-tile" data-gallery-index={i} aria-label={galleryLabel(i)}><Photo {src} alt={tour.galleryAlts[i][lang]} data-alt-es={tour.galleryAlts[i].es} data-alt-en={tour.galleryAlts[i].en} sizes="(max-width: 760px) 88vw, 70vw" loading={i<2?'eager':'lazy'} fetchpriority="low"/></button>)}</div><button type="button" class="gallery-arrow gallery-next" data-gallery-step="1" aria-controls="detail-gallery" aria-label={lang==='en'?'Next photograph':'Fotografía siguiente'}><span aria-hidden="true">→</span></button></div></div>{tourReviews.length>0&&<aside><C tag="h2" es="Historias de viajeros" en="Guest stories"/>{tourReviews.map(review=><article class="experience-review"><blockquote><C {...review.body}/></blockquote><p>{review.name}</p><a href={review.url} target="_blank" rel="noopener noreferrer"><C es="Ver reseña verificada" en="Read verified review"/></a></article>)}</aside>}</section>
 <section class="experience-options section-pad"><C tag="h2" class="display-title" {...tour.sectionsTitle}/>{optionBlocks.map(block=>block.type==='extra'?<details class="experience-extra"><C tag="summary" {...block.title}/><div class="experience-extra-body">{block.body.map(text=><C tag="p" {...text}/>)}<C tag="a" class="text-link" href={`/contact/?tour=${tour.id}`} es="Pide que lo incluyamos en tu propuesta" en="Ask to include this in your proposal"/></div></details>:block.type==='heading'?<C tag="h3" {...block.text}/>:<C tag="p" {...block.text}/>)}</section>
 <section class="section-pad experience-faq"><C tag="h2" class="display-title" {...tour.faqsTitle}/>{tour.faqs.map(faq=><details><C tag="summary" {...faq.question}/>{paragraphs(faq.answer).map(p=><C tag="p" {...p}/>)}</details>)}</section>
 {relatedPosts.length>0&&<section class="section-pad"><C tag="h2" class="display-title" es="Una mirada local" en="A local perspective"/><div class="stories-grid">{relatedPosts.map(post=><a class="story-card" href={localizedHref(`/journal/${post.slug}/`,lang)}><Photo src={post.image} alt={post.imageAlt?.[lang]||post.title[lang]} data-alt-es={post.imageAlt?.es||post.title.es} data-alt-en={post.imageAlt?.en||post.title.en}/><C tag="h3" {...post.title}/></a>)}</div></section>}
 <section class="final-cta section-pad"><C tag="h2" class="display-title" {...tour.finalCta.title}/><C tag="p" {...tour.finalCta.body}/><C tag="a" class="button" data-tour-contact href={`/contact/?tour=${tour.id}`} es="Planifiquemos tu experiencia" en="Let’s Plan Your Experience"/></section>
 <section class="section-pad related-experiences"><C tag="h2" class="display-title" es="Sigue explorando" en="Keep exploring"/><nav class="related-tour-grid">{tours.filter(t=>t.id!==tour.id).map(t=><a href={localizedHref(`/experiences/${t.slug}/`,lang)}><Photo src={t.image} alt={t.imageAlt[lang]} data-alt-es={t.imageAlt.es} data-alt-en={t.imageAlt.en} sizes="(max-width: 760px) 50vw, 20vw"/><C {...t.short}/></a>)}</nav></section>
</main>
