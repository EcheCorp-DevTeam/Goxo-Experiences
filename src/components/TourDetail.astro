---
import C from './Copy.astro';
import {tours} from '../data/tours';
import official from '../data/official';
import imageAlts from '../data/image-alts';
import {languageOf,localizedHref} from '../data/urls';
const {tour,generic=false}=Astro.props;
const lang=languageOf(Astro.url.pathname);
---
<main id="main" data-detail-id={generic?'custom':tour.id}>
<section class="detail-hero">{tour.image&&<img src={tour.image} alt={tour.imageAlt?.[lang]||''} data-bind-image="image" width="1920" height="1200" fetchpriority="high"/>}<C tag="a" class="detail-back" href="/experiences/" es="← Todas las experiencias" en="← All experiences"/><div class="detail-hero-content"><C tag="h1" data-bind="name" {...tour.name}/><div class="detail-facts"><C data-bind="duration" {...tour.duration}/><C es="Experiencia privada" en="Private experience"/><C {...tour.guests}/></div></div></section>
<section class="detail-intro section-pad"><div><C tag="p" class="eyebrow" data-bind="location" {...tour.location}/><C tag="h2" data-bind="description" {...tour.catalogDescription}/><C tag="p" class="tour-story" data-bind="story" {...tour.story}/></div><aside class="booking-card"><C tag="h3" es="Consultar disponibilidad" en="Check Availability"/><C tag="p" es="Cuéntanos cuándo vienes y con quién. Endika te preparará una propuesta con disponibilidad y precio." en="Tell us when you’re coming and who’s joining you. Endika will prepare a proposal with availability and price."/><C tag="a" class="button" data-tour-contact href={`/contact/?tour=${tour.id}`} es="Consultar disponibilidad" en="Check Availability"/><C tag="p" class="form-note" es="La consulta no confirma una reserva ni realiza un pago." en="An enquiry does not confirm a booking or make a payment."/></aside></section>
<section class="route-section section-pad"><C tag="h2" class="display-title" es="Itinerario orientativo" en="An outline of your day"/><div class="route-grid" id="route-grid">{tour.stops.map((stop,i)=><article class="route-step"><C tag="h3" {...stop}/><C tag="p" {...tour.stopCopy[i]}/></article>)}</div></section>
{tour.gallery.length>0&&<section class="detail-gallery section-pad"><C tag="h2" class="display-title" es="Acércate un poco más." en="Look a little closer."/><div class="gallery-grid" id="detail-gallery">{tour.gallery.map((src,i)=><button class="gallery-tile" data-gallery-index={i} aria-label={lang==='en'?`Expand photograph ${i+1}`:`Ampliar fotografía ${i+1}`}><img src={src} alt={tour.galleryAlts?.[i]?.[lang]||imageAlts[src]?.[lang]||tour.short[lang]} loading="lazy" width="1000" height="700"/><C es="Ampliar" en="Expand"/></button>)}</div></section>}
<section class="details-columns section-pad"><div><C tag="h3" es="Incluye" en="Included"/><ul id="tour-includes">{tour.includes.map(item=><C tag="li" {...item}/>)}</ul></div><div><C tag="h3" es="Tu propuesta personal" en="Your personal proposal"/><ul id="tour-excludes">{tour.excludes.map(item=><C tag="li" {...item}/>)}</ul></div><div><C tag="h3" es="Punto de encuentro" en="Meeting point"/><C tag="p" {...official.faqs[3].answer}/></div></section>
<section class="section-pad experience-faq"><C tag="h2" class="display-title" {...official.faqTitle}/>{[official.faqs[2],official.faqs[4],official.faqs[7]].map(faq=><details><C tag="summary" {...faq.question}/><C tag="p" {...faq.answer}/></details>)}<C tag="p" data-bind="faq" {...tour.faq}/></section>
<section class="section-pad related-experiences"><C tag="h2" class="display-title" es="Sigue descubriendo" en="Keep discovering"/><nav><C tag="a" href="/" es="Inicio" en="Home"/><C tag="a" href="/about/" es="Acerca de GOXO" en="About GOXO"/>{tours.filter(t=>t.published&&t.id!==tour.id).map(t=><C tag="a" href={`/experiences/${t.slug}/`} {...t.short}/>)}</nav></section>
<C tag="a" class="button sticky-tour-cta" data-tour-contact href={`/contact/?tour=${tour.id}`} es="Consultar disponibilidad" en="Check Availability"/>
</main>
