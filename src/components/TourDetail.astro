---
import C from './Copy.astro';
const {tour,generic=false}=Astro.props;
---
<main id="main" data-detail-id={generic?'custom':tour.id}>
<section class="detail-hero"><img src={tour.image} alt={tour.location.es} data-bind-image="image" width="1920" height="1200" fetchpriority="high"/><C tag="a" class="detail-back" href="/experiencias/" es="← Todas las experiencias" en="← All experiences"/><div class="detail-hero-content"><C tag="p" class="eyebrow" data-bind="eyebrow" {...tour.eyebrow}/><C tag="h1" data-bind="name" {...tour.name}/><div class="detail-facts"><C data-bind="duration" {...tour.duration}/><C es="Experiencia privada" en="Private experience"/><span>ES / EN</span></div></div></section>
<section class="detail-intro section-pad"><div><C tag="p" class="eyebrow" data-bind="location" {...tour.location}/><C tag="h2" data-bind="description" {...tour.description}/><C tag="p" data-bind="story" {...tour.story}/></div><aside class="booking-card"><C tag="h3" es="Vamos a hacerlo tuyo." en="Let’s make it yours."/><C tag="p" es="Cuéntanos cuándo vienes y con quién. Endika te preparará una propuesta con disponibilidad y precio." en="Tell us when you’re coming and who’s joining you. Endika will prepare a proposal with availability and price."/><C tag="a" class="button" data-tour-contact href={`/contacto/?tour=${tour.id}`} es="Quiero vivir esta experiencia ↗" en="I want to experience this ↗"/><C tag="button" class="button button-outline" data-open-360 data-tour-immersive hidden={!tour.immersive} es="Probar la ventana 360°" en="Try the 360° window"/><C tag="p" class="form-note" es="La consulta no confirma una reserva ni realiza un pago." en="An enquiry does not confirm a booking or make a payment."/><C tag="a" class="text-link" style="margin-top:14px;font-size:12px" href="/politica-de-cancelacion/" es="Política de cancelación ↗" en="Cancellation policy ↗"/></aside></section>
<section class="route-section section-pad"><C tag="p" class="eyebrow" es="EL RECORRIDO" en="THE ITINERARY"/><C tag="h2" class="display-title" es="Momentos que te esperan." en="Moments waiting for you."/><div class="route-grid" id="route-grid">{tour.stops.map((stop,i)=><article class="route-step"><span>0{i+1}</span><C tag="h3" {...stop}/><C tag="p" {...tour.stopCopy[i]}/></article>)}</div></section>
<section class="detail-gallery section-pad"><div class="section-heading"><C tag="h2" class="display-title" es="Acércate un poco más." en="Look a little closer."/>{tour.id==='costa-vasca'&&<C tag="button" class="text-link" data-open-film es="Ver Gaztelugatxe en video ▷" en="Watch Gaztelugatxe on film ▷"/>}</div><div class="gallery-grid" id="detail-gallery">{tour.gallery.map((src,i)=><button class="gallery-tile" data-gallery-index={i} aria-label={`Ampliar fotografía ${i+1}`}><img src={src} alt={tour.location.es} loading="lazy" width="1000" height="700"/><C es="Ampliar ↗" en="Expand ↗"/></button>)}</div><C tag="p" class="gallery-caption" es="Fotografías de referencia del destino y su cultura. Consulta las fuentes en Créditos visuales." en="Reference photographs of the destination and its culture. See sources in Visual credits."/></section>
<section class="details-columns section-pad"><div><C tag="h3" es="Incluye" en="Included"/><ul id="tour-includes">{tour.includes.map(item=><C tag="li" {...item}/>)}</ul></div><div><C tag="h3" es="No incluye" en="Not included"/><ul id="tour-excludes">{tour.excludes.map(item=><C tag="li" {...item}/>)}</ul></div><div><C tag="h3" es="Antes de venir" en="Before you arrive"/><C tag="p" data-bind="faq" {...tour.faq}/></div></section>
<C tag="a" class="button sticky-tour-cta" data-tour-whatsapp href={`https://wa.me/34644714642?text=${encodeURIComponent('Kaixo, me interesa '+tour.short.es)}`} target="_blank" rel="noopener noreferrer" es="Habla con Endika ↗" en="Talk to Endika ↗"/>
</main>
