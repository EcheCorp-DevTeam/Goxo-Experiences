---
import Dashboard from '../components/cms/Dashboard.astro';
import Editor from '../components/cms/Editor';
import '../styles/cms-editor.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
export const prerender=false;
const dashboard=Astro.url.pathname.replace(/\/$/,'')==='/keystatic';
if(Astro.url.pathname.replace(/\/$/,'')==='/keystatic/singleton/articles')return Astro.redirect('/keystatic/collection/articles',302);
---
{dashboard?<Dashboard />:<html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Editor · GOXO Studio</title></head><body class="cms-editor"><Editor client:only="react" /></body></html>}
