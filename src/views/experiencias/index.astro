---
import Base from '../../layouts/Base.astro';
import C from '../../components/Copy.astro';
import TourCard from '../../components/TourCard.astro';
import {tours} from '../../data/tours';
import official from '../../data/official';
import settings from '../../content/site/settings.json';
import {languageOf} from '../../data/urls';
const lang=languageOf(Astro.url.pathname);
---
<Base title={settings.catalogSeoTitle[lang]} description={official.catalogIntro[lang]}><main id="main" class="catalog-page"><section class="page-heading section-pad"><C tag="h1" {...official.catalogTitle}/><C tag="p" {...official.catalogIntro}/></section><section class="experiences-section section-pad"><div class="tours-grid" id="tours-grid">{tours.map(tour=><TourCard tour={tour} catalog/>)}</div></section></main></Base>


