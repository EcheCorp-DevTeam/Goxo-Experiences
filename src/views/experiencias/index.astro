---
import Base from '../../layouts/Base.astro';
import C from '../../components/Copy.astro';
import TourCard from '../../components/TourCard.astro';
import {tours} from '../../data/tours';
import official from '../../data/official';
import settings from '../../content/site/settings.json';
import {languageOf} from '../../data/urls';
const lang=languageOf(Astro.url.pathname);
// One line per sentence, so the heading breaks after the first full stop.
const lines=(text:string)=>text.split(/(?<=\.)\s+/);
const titleEs=lines(official.catalogTitle.es),titleEn=lines(official.catalogTitle.en);
---
<Base title={settings.catalogSeoTitle[lang]} description={official.catalogIntro[lang]}><main id="main" class="catalog-page"><section class="page-heading section-pad"><h1>{titleEn.map((line,i)=><C class="title-line" es={titleEs[i]??line} en={line}/>)}</h1><C tag="p" {...official.catalogIntro}/></section><section class="experiences-section section-pad"><div class="tours-grid" id="tours-grid">{tours.map(tour=><TourCard tour={tour} catalog/>)}</div></section></main></Base>


