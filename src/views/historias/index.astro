---
import Base from '../../layouts/Base.astro';
import C from '../../components/Copy.astro';
import {posts} from '../../data/tours';
import {languageOf,localizedHref} from '../../data/urls';
const lang=languageOf(Astro.url.pathname);
---
<Base title={lang==='en'?'Travel Journal | GOXO':'Diario de viaje | GOXO'}><main id="main"><section class="page-heading section-pad"><C tag="p" class="eyebrow" es="EL CUADERNO DE GOXO" en="THE GOXO JOURNAL"/><C tag="h1" es="Diario de viaje" en="Travel Journal"/><C tag="p" es="Lugares, sabores y pequeñas maneras de acercarse al País Vasco." en="Places, flavours and little ways to get closer to the Basque Country."/></section><section class="stories-section section-pad">{posts.length===0&&<C tag="p" class="journal-empty" es="Próximamente compartiremos historias, lugares y recomendaciones de GOXO." en="Stories, places and recommendations from GOXO are coming soon."/>}<div class="stories-grid">{posts.map(post=><a class="story-card" href={localizedHref(`/journal/${post.slug}/`,lang)}><img src={post.image} alt={post.imageAlt?.[lang]||post.title[lang]} width="900" height="650" loading="lazy"/><C tag="p" class="eyebrow" {...post.category}/><C tag="h3" {...post.title}/><C tag="p" {...post.intro}/></a>)}</div></section></main></Base>
