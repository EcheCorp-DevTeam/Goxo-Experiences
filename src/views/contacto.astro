---
import Base from '../layouts/Base.astro';
import C from '../components/Copy.astro';
import {tours} from '../data/tours';
import media from '../data/media.json';
import official from '../data/official.json';
import {languageOf} from '../data/urls';
const lang=languageOf(Astro.url.pathname);
---
<Base title={lang==='en'?'Plan Your Experience | GOXO':'Planifica tu experiencia | GOXO'} description={official.finalBody[lang]}><main id="main"><section class="page-heading section-pad"><C tag="p" class="eyebrow" es="DE TU IDEA AL VIAJE" en="FROM YOUR IDEA TO YOUR JOURNEY"/><C tag="h1" es="Planifica tu experiencia." en="Plan Your Experience."/></section><section class="contact-layout section-pad"><aside class="contact-aside"><C tag="h2" es="Te escucha Endika." en="Endika is listening."/><C tag="p" es="Una fecha, un grupo y algo que os gustaría vivir. A partir de ahí, preparamos juntos la experiencia." en="A date, a group and something you would love to experience. From there, we plan your journey together."/><a class="text-link" href="https://wa.me/34644714642" target="_blank" rel="noopener noreferrer">WhatsApp · +34 644 714 642 ↗</a><a href="mailto:kaixo@goxoexperiences.com">kaixo@goxoexperiences.com</a><div class="contact-extra"><C tag="strong" es="Punto de encuentro" en="Meeting point"/><C tag="p" style="margin:0" {...official.faqs[3].answer}/></div><img class="contact-image" src={media.coast} alt="Costa de Gaztelugatxe" width="900" height="600" loading="lazy"/></aside><div><noscript><p><C es="Consulta disponibilidad por WhatsApp o correo electrónico usando los enlaces de contacto." en="Check availability by WhatsApp or email using the contact links."/></p></noscript><form id="contact-form" class="form-grid"><label><C es="Tu nombre" en="Your name"/><input name="name" autocomplete="given-name" required maxlength="80"/></label><label><C es="Correo electrónico" en="Email address"/><input type="email" name="email" autocomplete="email" required maxlength="150"/></label><label class="full"><C es="¿Qué experiencia te interesa?" en="Which experience interests you?"/><select name="tour" id="contact-tour"><C tag="option" value="personalizada" es="Quiero una recomendación" en="I’d like a recommendation"/>{tours.map(tour=><C tag="option" value={tour.id} {...tour.short}/>)}</select></label><label><C es="Fecha aproximada (opcional)" en="Approximate date (optional)"/><input type="date" name="date"/></label><label><C es="Idioma del tour" en="Tour language"/><select name="tourLang"><C tag="option" value="es" es="Español" en="Spanish"/><C tag="option" value="en" es="Inglés" en="English"/></select></label><label><C es="Personas" en="Guests"/><input type="number" name="guests" min="2" max="8" value="2" required/></label><label class="full"><C es="¿Qué te gustaría vivir?" en="What would you love to experience?"/><textarea name="message" rows="4" maxlength="1500"></textarea></label><C tag="p" class="form-note full" es="Prepararemos un mensaje para WhatsApp. Podrás revisarlo antes de enviarlo; este formulario no envía correos ni guarda tus datos en un servidor. Más información en nuestra política de privacidad." en="We’ll prepare a WhatsApp message. You can review it before sending; this form does not send emails or save your details to a server. More information in our privacy policy."/><C tag="a" class="text-link full" style="font-size:12px" href="/privacidad-y-cookies/" es="Ver política de privacidad y cookies ↗" en="See privacy and cookies policy ↗"/><C tag="button" type="submit" class="button full" es="Preparar mi consulta ↗" en="Prepare my enquiry ↗"/></form><section id="contact-result" class="contact-result" hidden><C tag="h3" es="Tu mensaje está listo." en="Your message is ready."/><p id="contact-preview" style="white-space:pre-wrap;font-size:14px"></p><C tag="a" id="contact-whatsapp" class="button" target="_blank" rel="noopener noreferrer" es="Abrir WhatsApp para enviarlo ↗" en="Open WhatsApp to send it ↗"/><C tag="p" class="form-note" es="La consulta se enviará cuando pulses Enviar dentro de WhatsApp." en="Your enquiry will be sent when you press Send inside WhatsApp."/></section></div></section></main></Base>

