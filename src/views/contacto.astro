---
import Base from '../layouts/Base.astro';
import C from '../components/Copy.astro';
import {tours} from '../data/tours';
import media from '../content/site/media.json';
import official from '../data/official';
import settings from '../content/site/settings.json';
import {languageOf} from '../data/urls';
const lang=languageOf(Astro.url.pathname);
---
<Base title={settings.contactSeoTitle[lang]} description={official.finalBody[lang]}><main id="main"><section class="page-heading section-pad"><C tag="p" class="eyebrow" es="DE TU IDEA AL VIAJE" en="FROM YOUR IDEA TO YOUR JOURNEY"/><C tag="h1" es="Planifica tu experiencia." en="Plan Your Experience."/></section><section class="contact-layout section-pad"><aside class="contact-aside"><C tag="h2" es="Te escucha Endika." en="Endika is listening."/><C tag="p" es="Una fecha, un grupo y algo que os gustaría vivir. A partir de ahí, preparamos juntos la experiencia." en="A date, a group and something you would love to experience. From there, we plan your journey together."/><a class="text-link" href={`https://wa.me/${settings.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp · {settings.telephone} ↗</a><a href={`mailto:${settings.email}`}>{settings.email}</a><div class="contact-extra"><C tag="strong" es="Punto de encuentro" en="Meeting point"/><C tag="p" style="margin:0" {...official.faqs[3].answer}/></div><img class="contact-image" src={media.coast} alt="Costa de Gaztelugatxe" width="900" height="600" loading="lazy"/></aside><div><noscript><p><C es="Consulta disponibilidad por WhatsApp o correo electrónico usando los enlaces de contacto." en="Check availability by WhatsApp or email using the contact links."/></p></noscript><form id="contact-form" class="form-grid"><label><C es="Tu nombre" en="Your name"/><input name="name" autocomplete="given-name" required maxlength="80"/></label><label><C es="Correo electrónico" en="Email address"/><input type="email" name="email" autocomplete="email" required maxlength="150"/></label><label class="full"><C es="¿Qué experiencia te interesa?" en="Which experience interests you?"/><select name="tour" id="contact-tour"><C tag="option" value="personalizada" es="Quiero una recomendación" en="I’d like a recommendation"/>{tours.map(tour=><C tag="option" value={tour.id} {...tour.short}/>)}</select></label><label><C es="Fecha aproximada (opcional)" en="Approximate date (optional)"/><input type="date" name="date"/></label><label><C es="Idioma del tour" en="Tour language"/><select name="tourLang"><C tag="option" value="es" es="Español" en="Spanish"/><C tag="option" value="en" es="Inglés" en="English"/></select></label><label><C es="Personas" en="Guests"/><input type="number" name="guests" min="2" max="8" value="2" required/></label><label class="full"><C es="¿Qué te gustaría vivir?" en="What would you love to experience?"/><textarea name="message" rows="4" maxlength="1500"></textarea></label><C tag="p" class="form-note full" es="Tus datos se enviarán por correo electrónico a Endika solo para responder a tu consulta. Más información en nuestra política de privacidad." en="Your details are emailed to Endika only to reply to your enquiry. More information in our privacy policy."/><C tag="a" class="text-link full" style="font-size:12px" href="/privacidad-y-cookies/" es="Ver política de privacidad y cookies ↗" en="See privacy and cookies policy ↗"/><C tag="button" type="submit" class="button full" es="Enviar mi consulta" en="Send my enquiry"/></form><section id="contact-result" class="contact-result" role="status" tabindex="-1" hidden><C tag="h3" es="Mensaje enviado." en="Message sent."/><C tag="p" es="Gracias por ponerte en contacto. Endika te responderá por correo electrónico para ayudarte a planificar tu experiencia." en="Thank you for getting in touch. Endika will reply by email to help you plan your experience."/></section></div></section></main></Base>

