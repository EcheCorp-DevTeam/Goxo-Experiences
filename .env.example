# Keep false for review builds. Set true only for the public launch.
PUBLIC_INDEXABLE=false
PUBLIC_SITE_URL=https://goxoexperiences.com
# Set only when GOXO's real Google Business Profile is ready.
PUBLIC_GOOGLE_REVIEWS_URL=
# Search Console verification is optional until account access is supplied.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
# Analytics activation and consent setup are pending account access.

# Endpoint that receives the "Plan Your Experience" form and emails it to Endika.
# Leave empty until the email service exists; the form then points visitors to the email address.
PUBLIC_CONTACT_ENDPOINT=
